# Copie para .env.local. Esses valores são públicos por natureza:
# a proteção dos dados está em firestore.rules, não em esconder esta configuração.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" conecta aos emuladores locais e nunca toca em produção (npm run dev:emulador).
VITE_USE_FIREBASE_EMULATOR=false

# Opcional. Chave pública do Sentry (DSN). Vazia: nenhum relatório de erro é enviado.
VITE_SENTRY_DSN=

# Opcional. Troca o email de contato da política de privacidade e dos termos.
VITE_CONTATO_EMAIL=
